# Nothing below is required to run the app locally — every route/script
# degrades gracefully without it (see each one's own fallback).
#
# Live COE premiums (src/app/drive/api/coe/route.js) and car prices
# (src/app/drive/api/cars/route.js) both come from public, keyless sources
# — data.gov.sg's mirror of LTA's COE dataset, and the OneMotoring Car Cost
# Update PDF, respectively. Neither needs an API key or account.

# Supabase — reference-data mirror (car catalog, COE bidding history) only.
# No auth, no user data. See supabase/migrations/0001_reference_data.sql.
# Without these set, src/app/drive/api/car-catalog and
# src/app/drive/api/coe-history both fall back to the bundled
# public/data/*.json snapshot, same as today.
SUPABASE_URL=
# Public-safe read key — RLS on both tables allows only SELECT to this key.
SUPABASE_ANON_KEY=
# Bypasses RLS entirely. Used ONLY by scripts/refresh-*.mjs (never shipped
# to a browser) — set as a GitHub Actions repo secret for CI, not here for
# local dev unless you're testing the refresh scripts against your own
# project. Treat this like a root database password.
SUPABASE_SERVICE_ROLE_KEY=
